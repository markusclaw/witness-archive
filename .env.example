# Copy to .env.local for local dev. Set the same two vars in Cloudflare Pages → Settings → Environment variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Formatting assistant (server-only secret — set in Cloudflare as a Secret, never NEXT_PUBLIC_)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Analytics 4 measurement id (optional; leave empty to disable)
NEXT_PUBLIC_GA_ID=G-BTC45VG71W

# Server-only: lets the translate route cache translations (never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Shelved: server-side YouTube transcript import (YouTube refuses most data-center requests). Set to 1 to re-enable.
# NEXT_PUBLIC_TRANSCRIPT_IMPORT=1

# Optional: YouTube Data API v3 key (runtime secret). Enables publish date, duration, description and language from a video link; without it oEmbed gives title + channel only.
# YOUTUBE_API_KEY=

# Narrated audio (one MP3 per testimony per language, Google Cloud Text-to-Speech).
# Enable "Cloud Text-to-Speech API" in Google Cloud and create an API key. Runtime secret on Cloudflare.
GOOGLE_TTS_API_KEY=
# Optional voice overrides, e.g. en-US-Chirp3-HD-Kore / es-US-Chirp3-HD-Kore / pt-BR-Chirp3-HD-Kore
# GOOGLE_TTS_VOICE_EN=
# GOOGLE_TTS_VOICE_ES=
# GOOGLE_TTS_VOICE_PT=
